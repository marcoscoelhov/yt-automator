# ========================================
# YT-Automator - Variáveis de Ambiente
# ========================================
# Copie este arquivo para .env e preencha suas API keys
# NUNCA commite o arquivo .env no Git!

# ----------------------------------------
# Google AI (Gemini)
# ----------------------------------------
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ----------------------------------------
# OpenAI (Opcional - DALL-E, GPT)
# ----------------------------------------
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ----------------------------------------
# ElevenLabs (Opcional - TTS premium)
# ----------------------------------------
# Obtenha em: https://elevenlabs.io/api
ELEVENLABS_API_KEY=

# ----------------------------------------
# Replicate (Opcional - Stable Diffusion)
# ----------------------------------------
# Obtenha em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ----------------------------------------
# Hugging Face (Opcional - Modelos Open Source)
# ----------------------------------------
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=

# ----------------------------------------
# AWS (Opcional - S3, Polly)
# ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ----------------------------------------
# Configurações do Servidor
# ----------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
