# ========================================
# YT-Automator - Variáveis de Ambiente
# ========================================
# Copie este arquivo para .env e preencha suas API keys
# NUNCA commite o arquivo .env no Git!

# ----------------------------------------
# Google AI (Gemini)
# ----------------------------------------
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ----------------------------------------
# OpenAI (Opcional - DALL-E, GPT)
# ----------------------------------------
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MISSION_CONTROL_ENDPOINTS=http://127.0.0.1:3000/api/video-event

# ----------------------------------------
# ElevenLabs (Opcional - TTS premium)
# ----------------------------------------
# Obtenha em: https://elevenlabs.io/api
ELEVENLABS_API_KEY=

# ----------------------------------------
# Replicate (Opcional - Stable Diffusion)
# ----------------------------------------
# Obtenha em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ----------------------------------------
# Hugging Face (Opcional - Modelos Open Source)
# ----------------------------------------
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=

# ----------------------------------------
# AWS (Opcional - S3, Polly)
# ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ----------------------------------------
# Configurações do Servidor
# ----------------------------------------
OUTPUT_BASE_URL=http://YOUR_VPS_IP:8020/static/
SERVER_HOST=0.0.0.0
SERVER_PORT=8020
DEBUG=true
YT_AUTOMATOR_BACKEND_URL=http://127.0.0.1:8020
YT_AUTOMATOR_MEDIA_OUTBOUND=/root/.openclaw/media/outbound
YT_AUTOMATOR_INTEL_FILE=/root/.openclaw/workspace/intel/DAILY-INTEL.md
YT_AUTOMATOR_JOBS_DB=/root/.openclaw/workspace/apps/yt-automator/backend/jobs.sqlite3
YT_AUTOMATOR_WORKER_POLL_SECONDS=2
YT_AUTOMATOR_WORKER_STALE_AFTER_SECONDS=90
YT_AUTOMATOR_JOB_POLL_SECONDS=5
YT_AUTOMATOR_JOB_TIMEOUT_SECONDS=3600
YT_AUTOMATOR_BG_MUSIC_PATH=
YT_AUTOMATOR_BG_MUSIC_CATALOG=/root/.openclaw/workspace/apps/yt-automator/backend/assets/music/catalog.json
YT_AUTOMATOR_BG_MUSIC_GAIN_DB=-15
YT_AUTOMATOR_TARGET_LUFS=-16
YT_AUTOMATOR_TARGET_LRA=7
YT_AUTOMATOR_VOICE_HUM_CUT_HZ=85
YT_AUTOMATOR_VOICE_LOWPASS_HZ=9500
YT_AUTOMATOR_VOICE_DENOISE_FLOOR_DB=-20
YT_AUTOMATOR_VOICE_COMP_THRESHOLD=0.12
YT_AUTOMATOR_VOICE_COMP_RATIO=1.6
YT_AUTOMATOR_TEMP_RETENTION_HOURS=12
YT_AUTOMATOR_RUNS_RETENTION_DAYS=14
YT_AUTOMATOR_STATIC_RETENTION_DAYS=0
VIDEO_OUTPUT_WIDTH=1920
VIDEO_OUTPUT_HEIGHT=1080
VIDEO_OUTPUT_FPS=24
VIDEO_OUTPUT_PRESET=fast
VIDEO_OUTPUT_CRF=18
VIDEO_OUTPUT_THREADS=4
VIDEO_TEST_OUTPUT_WIDTH=854
VIDEO_TEST_OUTPUT_HEIGHT=480
VIDEO_TEST_OUTPUT_FPS=18
VIDEO_TEST_OUTPUT_PRESET=ultrafast
VIDEO_TEST_OUTPUT_CRF=30
VIDEO_TEST_OUTPUT_THREADS=2
